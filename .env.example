# Aucune clé API n'est requise pour l'application principale.
# Les variables ci-dessous sont optionnelles.

MONITOR_INTERVAL_MINUTES=5
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=5000

# Valeurs de repli des préférences (surchargeables depuis /parametres,
# avec la priorité : valeur en base > variable d'env > défaut embarqué).

# Nom affiché de l'application
APP_NAME=EV Charging Monitor

# Sous-titre affiché dans l'interface
APP_SUBTITLE=Disponibilité des bornes de recharge

# Connecteur surveillé par défaut (CHADEMO, COMBO_TYPE_2, MENNEKES_TYPE_2, ...)
DEFAULT_CONNECTOR_TYPE=CHADEMO
